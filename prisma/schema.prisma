generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  PETUGAS
  WARGA
}

enum SubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ========================================
// MODEL USER
// ========================================
model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  role Role @default(WARGA)

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  totalPoint Int @default(0)

  // AUTH.JS
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  // LOGIN
  rememberMe  Boolean   @default(false)
  lastLoginAt DateTime?

  // RELATIONS
  submissions   Submission[]
  notifications Notification[]
  auditLogs     AuditLog[]
  profile       Profile?     // ✅ ONE-TO-ONE (1:1) dengan Profile
  rewards       UserReward[] // ✅ MANY-TO-MANY (N:N) dengan Reward via UserReward

  // TIMESTAMP
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// MODEL PROFILE (ONE-TO-ONE dengan User)
// ========================================
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique // ✅ UNIQUE = ONE-TO-ONE
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  phone     String?
  address   String?
  birthDate DateTime?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// MODEL FOTO SAMPAH (ONE-TO-ONE dengan Submission)
// ========================================
model FotoSampah {
  id           String   @id @default(cuid())
  submissionId String   @unique // ✅ UNIQUE = ONE-TO-ONE
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String
  createdAt    DateTime @default(now())
}

// ========================================
// MODEL REWARD (MANY-TO-MANY dengan User via UserReward)
// ========================================
model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  pointCost   Int
  stock       Int      @default(0)
  users       UserReward[] // ✅ Relasi MANY-TO-MANY
  createdAt   DateTime @default(now())
}

// ========================================
// MODEL USER REWARD (TABEL PENGHUBUNG N:N)
// ========================================
model UserReward {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward @relation(fields: [rewardId], references: [id])
  quantity  Int    @default(1)
  claimedAt DateTime @default(now())

  @@unique([userId, rewardId]) // 1 user 1 reward hanya 1x
}

// ========================================
// MODEL REGION
// ========================================
model Region {
  id String @id @default(cuid())

  name     String
  district String

  users       User[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// MODEL WASTE CATEGORY
// ========================================
model WasteCategory {
  id String @id @default(cuid())

  name  String
  point Int

  submissions Submission[]

  createdAt DateTime @default(now())
}

// ========================================
// MODEL SUBMISSION
// ========================================
model Submission {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id])

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  categoryId String
  category   WasteCategory @relation(fields: [categoryId], references: [id])

  weight Float

  photo String // Bisa dipertahankan atau pindah ke FotoSampah

  point Int

  status SubmissionStatus @default(PENDING)

  fotoSampah FotoSampah? // ✅ ONE-TO-ONE dengan FotoSampah

  createdAt DateTime @default(now())
}

// ========================================
// MODEL NOTIFICATION
// ========================================
model Notification {
  id String @id @default(cuid())

  title   String
  message String

  isRead Boolean @default(false)

  userId String
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ========================================
// MODEL AUDIT LOG
// ========================================
model AuditLog {
  id String @id @default(cuid())

  action      String
  description String

  userId String
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ========================================
// AUTH.JS MODELS
// ========================================
model Account {
  id                String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires DateTime
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}